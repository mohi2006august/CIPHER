---
// src/components/Preloader.astro
---
<div id="cipher-preloader">
  <div class="preloader-door top"></div>
  <div class="preloader-door bottom"></div>
  <div class="preloader-content">
    <div class="brand-reveal" data-text="CIPHER">CIPHER</div>
  </div>
</div>

<style is:global>
#cipher-preloader {
  position: fixed;
  top: 0; left: 0;
  width: 100vw; height: 100vh;
  z-index: 99999;
  display: flex;
  justify-content: center;
  align-items: center;
  pointer-events: none;
}

.preloader-door {
  position: absolute;
  left: 0;
  width: 100%;
  height: 50vh;
  background: #050505;
  z-index: 1;
  transition: transform 0.8s cubic-bezier(0.86, 0, 0.07, 1);
}
.preloader-door.top { top: 0; }
.preloader-door.bottom { bottom: 0; }

#cipher-preloader.loaded .preloader-door.top {
  transform: translateY(-100%);
}
#cipher-preloader.loaded .preloader-door.bottom {
  transform: translateY(100%);
}

.preloader-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 1;
  transition: opacity 0.4s ease;
}

#cipher-preloader.loaded .preloader-content {
  opacity: 0;
}

.brand-reveal {
  font-family: var(--font-sans, 'Inter'), sans-serif;
  font-weight: 200;
  font-size: clamp(4rem, 12vw, 10rem); /* Massive text */
  letter-spacing: 20px;
  color: rgba(255, 255, 255, 0.05); /* Dim background text */
  text-transform: uppercase;
  position: relative;
}

/* The gold fill that acts as a loading mask */
.brand-reveal::before {
  content: attr(data-text);
  position: absolute;
  top: 0; left: 0;
  color: #D4AF37;
  overflow: hidden;
  white-space: nowrap;
  width: var(--fill, 0%);
  transition: width 0.1s linear;
  z-index: 2;
}

/* A soft sweeping light effect across the massive text */
.brand-reveal::after {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 50%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(212,175,55,0.4), transparent);
  animation: sweep 2.5s infinite;
  z-index: 3;
}
@keyframes sweep {
  100% { left: 200%; }
}
</style>
